#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        bhm: balanced_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;    // <---[[moderate duration]]
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ---------------------------------------------------------------------------------
            // |   `  |  1  |  2  |  3  |  4   |  5  |     |  6  |  7  |  8  |  9  |  0  | BKSP |
            // |  TAB |  Q  |  W  |  E  |  R   |  T  |     |  Y  |  U  |  I  |  O  |  P  |  \   |
            // |  ESC |  A  |  S  |  D  |  F   |  G  |     |  H  |  J  |  K  |  L  |  ;  |  ENT |
            // | SHFT |  Z  |  X  |  C  |  V   |  B  |     |  N  |  M  |  ,  |  .  |  /  |   '  |
            // |  F13 | CRT | ALT | GUI | BKSP | SPC |     | SPC | ENT |LARW |DARW |UARW | RARW |

            bindings = <
&kp EQUAL  &kp N1            &kp N2        &kp N3        &kp N4         &kp N5         &kp N6       &kp N7         &kp N8       &kp N9        &kp N0           &kp MINUS
&kp TAB    &kp Q             &kp W         &kp E         &kp R          &kp T          &kp Y        &kp U          &kp I        &kp O         &kp P            &kp BSLH
&kp ESC    &bhm LCTRL A      &bhm LALT S   &bhm LGUI D   &bhm LSHIFT F  &kp G          &kp H        &bhm RSHIFT J  &bhm RGUI K  &bhm RALT L   &bhm RCTRL SEMI  &kp APOS
&kp LSHFT  &kp Z             &kp X         &kp C         &kp V          &kp B          &kp N        &kp M          &kp COMMA    &kp DOT       &kp FSLH         &kp ENTER
&kp F13    &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp BACKSPACE  &lt 1 SPACE    &lt 2 SPACE  &lt 3 ENTER    &kp LEFT     &kp UP_ARROW  &kp DOWN_ARROW   &kp RIGHT
            >;
        };

        layer_2 {
            bindings = <
&trans  &bt BT_SEL 0       &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3           &bt BT_CLR    &trans     &trans   &trans  &trans  &trans     &trans
&trans  &kp N1             &kp N2        &kp N3        &kp N4                 &kp N5        &kp N6     &kp N7   &kp N8  &kp N9  &kp N0     &kp BSPC
&trans  &kp C_VOLUME_DOWN  &kp C_VOL_UP  &kp LPAR      &kp RIGHT_PARENTHESIS  &trans        &kp ASTRK  &kp N4   &kp N5  &kp N6  &kp PLUS   &kp EQUAL
&trans  &trans             &trans        &trans        &trans                 &trans        &kp FSLH   &kp N1   &kp N2  &kp N3  &kp MINUS  &trans
&trans  &trans             &trans        &trans        &trans                 &trans        &trans     &kp DOT  &kp N0  &trans  &trans     &trans
            >;
        };

        layer_3 {
            bindings = <
&trans     &trans           &trans     &trans    &trans          &trans              &trans             &trans           &trans                 &trans                &trans     &trans
&kp GRAVE  &kp EXCLAMATION  &kp AT     &kp HASH  &kp DOLLAR      &kp PERCENT         &kp CARET          &kp AMPS         &kp ASTRK              &kp LEFT_PARENTHESIS  &kp RPAR   &kp BACKSPACE
&trans     &kp TILDE        &kp SLASH  &kp LPAR  &kp LEFT_BRACE  &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp BACKSLASH         &kp PLUS   &kp KP_EQUAL
&trans     &trans           &trans     &trans    &trans          &trans              &trans             &trans           &trans                 &kp PIPE              &kp UNDER  &trans
&trans     &trans           &trans     &trans    &trans          &trans              &trans             &trans           &trans                 &trans                &trans     &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans    &trans  &trans         &trans  &trans    &trans     &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans    &trans  &kp PAGE_UP    &trans  &trans    &trans     &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans    &trans  &kp LEFT       &kp UP  &kp DOWN  &kp RIGHT  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &kp PAGE_DOWN  &trans  &trans    &trans     &trans
&trans  &trans  &trans   &trans   &trans   &trans    &trans  &trans         &trans  &trans    &trans     &trans
            >;
        };
    };
};
